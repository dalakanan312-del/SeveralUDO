# SQLite is the default. Use a Neon URL for hosted mode.
DATABASE_URL=sqlite:///./data/decades-v4.db
SESSION_SECRET=replace-with-at-least-32-random-characters
PUBLIC_URL=http://127.0.0.1:8000

# Google OAuth. Redirect URI: PUBLIC_URL/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Portrait generation: manual, comfyui, or openai
PORTRAIT_PROVIDER=manual
COMFYUI_URL=http://127.0.0.1:8188
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# Hosted download fallback when the installer is not bundled in the container.
DESKTOP_INSTALLER_URL=https://github.com/dalakanan312-del/SeveralUDO/releases/download/v4.4.5/Decades-Tracker-4.4.5-Setup.exe

# Optional external alerts. Browser/in-app alerts require no server setup.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=true

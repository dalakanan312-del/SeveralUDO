# Copy this file to .env and replace the placeholder values.
# Never commit your real .env file.
NEON_DATABASE_URL=postgresql://USER:PASSWORD@YOUR-POOLER-HOST/neondb?sslmode=require&channel_binding=require
# Required in production. Existing unassigned saves are visible only to this private workspace code.
OWNER_ACCESS_KEY=replace-with-a-long-private-code
# Recommended: stable encryption secret for 90-day trusted-device sessions.
AUTH_COOKIE_PASSWORD=replace-with-a-different-long-random-secret
# Optional future Google sign-in configuration. Email linking works without these.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
# Optional: enables era-accurate AI marriage portraits from two Sim portraits.
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_IMAGE_TOOL_MODEL=gpt-5.6

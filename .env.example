# Copy this file to .env and fill in your own Neon credentials.
# NEVER commit .env.

# Recommended pooled connection for normal app traffic:
NEON_DATABASE_URL=postgresql://USER:PASSWORD@YOUR-POOLER-HOST/neondb?sslmode=require

# Optional direct/non-pooler connection for schema setup and migrations:
NEON_DIRECT_URL=postgresql://USER:PASSWORD@YOUR-DIRECT-HOST/neondb?sslmode=require
